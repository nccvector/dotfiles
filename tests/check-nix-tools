#!/usr/bin/env python3
"""Real package/config smoke test; run via install.sh --command, never on host."""
import os
from pathlib import Path
import pty
import select
import shutil
import subprocess
import time

session = Path(os.environ["DOTFILES_SESSION"])
for tool in ("rg", "btop", "hx", "lazygit", "yazi", "zoxide", "fzf", "clangd",
             "clang-format", "clang-tidy", "pylsp", "black", "rust-analyzer", "rustfmt"):
    path = shutil.which(tool)
    assert path and str(Path(path).resolve()).startswith("/nix/store/"), (tool, path)
    print(tool, path, flush=True)
for args in (["rg", "--version"], ["btop", "--version"], ["hx", "--version"],
             ["lazygit", "--version"], ["yazi", "--version"], ["zoxide", "--version"]):
    subprocess.run(args, check=True)


def tui(args, quit_keys):
    master, slave = pty.openpty()
    # A real terminal size prevents false startup errors in TUIs.
    import fcntl
    import struct
    import termios
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 140, 0, 0))
    child = subprocess.Popen(args, stdin=slave, stdout=slave, stderr=slave)
    os.close(slave)
    output = bytearray()
    start = time.monotonic()
    sent = False
    try:
        while time.monotonic() - start < 20:
            if select.select([master], [], [], 0.1)[0]:
                try:
                    output.extend(os.read(master, 65536))
                except OSError:
                    break
            if not sent and time.monotonic() - start > 2:
                os.write(master, quit_keys)
                sent = True
            if child.poll() is not None:
                break
        assert child.wait(timeout=3) == 0, bytes(output).decode(errors="replace")
        text = bytes(output).decode(errors="replace").lower()
        for error in ("failed to parse", "invalid configuration", "unknown field", "unknown command"):
            assert error not in text, text
        print("TUI config/startup passed:", args[0], flush=True)
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()
        os.close(master)


tui(["hx", str(session / "scratch.txt")], b"\x1b:quit!\r")
tui(["yazi", str(session)], b"q")
# Lazygit versions report their resolved config directory without a TUI.
config_dir = subprocess.check_output(["lazygit", "--print-config-dir"], text=True).strip()
assert Path(config_dir).resolve() == Path(os.environ["CONFIG_DIR"]).resolve(), config_dir
print("Real Nix tool smoke checks passed.")
